<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RunTrack - Gestión de sensores"
            android:textColor="#1E88E5"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Disponibilidad"
            android:textColor="#1E88E5"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDisponibilidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Acelerómetro (m/s²)"
            android:textColor="#1E88E5"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAcel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Esperando datos..." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Giroscopio (rad/s)"
            android:textColor="#1E88E5"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGiro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Esperando datos..." />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swFiltro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:text="Filtro anti-duplicados"
            app:thumbTint="#1565C0"
            app:trackTint="#90CAF9" />

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#1565C0"
            android:text="Iniciar monitoreo en segundo plano"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>